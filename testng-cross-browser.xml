<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Cross Browser Regression"
       parallel="tests"
       thread-count="2"
       verbose="1">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.qa.homework.tests"/>
            <package name="com.qa.homework.failures"/>
        </packages>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="com.qa.homework.tests"/>
            <package name="com.qa.homework.failures"/>
        </packages>
    </test>
</suite>
